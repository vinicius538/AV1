{
  "name": "greencode",
  "version": "1.0.0",
  "private": true,
  "description": "CLI de logística reversa de equipamentos eletrônicos",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
